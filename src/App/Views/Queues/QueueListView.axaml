<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.ViewModels"
             xmlns:domain="using:ServiceBusExplorer"
             x:DataType="vm:QueueListViewModel"
             x:Class="ServiceBusExplorer.App.Views.Queues.QueueListView">
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8" Spacing="8">
      <TextBlock Text="Queues" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      <Button Content="+ New"
              Command="{Binding BeginCreateCommand}"
              VerticalAlignment="Center"
              AutomationProperties.Name="Create queue"
              AutomationProperties.HelpText="Opens the form for a new queue." />
      <TextBlock Text="Loading…" IsVisible="{Binding IsLoading}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

    <!-- Error + admin status -->
    <StackPanel Grid.Row="1" Margin="16,0,16,8" Spacing="4">
      <TextBlock Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 TextWrapping="Wrap" />
      <StackPanel Spacing="2"
                  IsVisible="{Binding AdminStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding AdminStatus}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   AutomationProperties.Name="Administration status"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Stale — conflict with service state"
                   IsVisible="{Binding IsAdminStale}"
                   Foreground="#C19C00"
                   FontSize="11"
                   AutomationProperties.Name="Administration stale conflict" />
        <TextBlock Text="Validation failed"
                   IsVisible="{Binding IsAdminValidationFailed}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   FontSize="11" />
        <TextBlock Text="Administration failed"
                   IsVisible="{Binding IsAdminFailed}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   FontSize="11" />
        <TextBlock Text="Administration succeeded"
                   IsVisible="{Binding IsAdminSucceeded}"
                   Foreground="#107C10"
                   FontSize="11" />
      </StackPanel>
    </StackPanel>

    <!-- Quick-create form -->
    <Border Grid.Row="2"
            IsVisible="{Binding IsCreating}"
            Margin="16,0,16,8"
            Padding="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            CornerRadius="4">
      <StackPanel Spacing="8">
        <TextBlock Text="New Queue" FontWeight="SemiBold" />
        <TextBox Text="{Binding NewQueueName}" Watermark="Queue name" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Create" Command="{Binding QuickCreateCommand}" />
          <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Column headers -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <Grid Grid.Row="0"
            ColumnDefinitions="*,100,100,100,80,Auto"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            Margin="16,0">
        <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Padding="8,6" />
        <TextBlock Grid.Column="1" Text="Active" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="2" Text="Dead Letter" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="3" Text="Scheduled" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="" Padding="8,6" />
      </Grid>

      <!-- Tag carries DeleteCommand so item templates avoid xmlns-prefixed DataContext casts
           (deferred DataTemplate build cannot resolve those types at runtime). -->
      <ListBox Grid.Row="1"
               ItemsSource="{Binding Queues}"
               SelectedItem="{Binding SelectedQueue}"
               Tag="{Binding DeleteCommand}"
               Margin="16,0"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type domain:QueueInfo}">
            <Grid ColumnDefinitions="*,100,100,100,80,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Name}" Padding="8,4" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ActiveMessageCount}" Padding="8,4"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Text="{Binding DeadLetterCount}" Padding="8,4"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
              <TextBlock Grid.Column="3" Text="{Binding ScheduledMessageCount}" Padding="8,4"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Text="{Binding Status}" Padding="8,4"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <Button Grid.Column="5" Content="Delete"
                      Command="{Binding $parent[ListBox].Tag}"
                      CommandParameter="{Binding Name}"
                      Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                      Padding="8,2"
                      AutomationProperties.Name="Delete queue" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
