<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.ViewModels"
             xmlns:domain="using:ServiceBusExplorer"
             xmlns:ctrl="using:ServiceBusExplorer.App.Views.Controls"
             x:DataType="vm:QueueDetailViewModel"
             x:Class="ServiceBusExplorer.App.Views.Queues.QueueDetailView">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,12,16,6">
      <TextBlock Text="{Binding Queue.Name, FallbackValue='Queue'}"
                 FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Text="Loading…" IsVisible="{Binding IsLoading}"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- Error + purge operation state -->
    <StackPanel Grid.Row="1" Margin="16,0,16,4" Spacing="4">
      <TextBlock Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 TextWrapping="Wrap" />
      <StackPanel Spacing="4"
                  IsVisible="{Binding PurgeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding PurgeStatus}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   AutomationProperties.Name="Purge status"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Purge cancelled"
                   IsVisible="{Binding IsPurgeCancelled}"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="11"
                   AutomationProperties.Name="Purge cancelled" />
        <TextBlock Text="Partial purge — confirmed removals only; remainder uncertain"
                   IsVisible="{Binding IsPurgePartial}"
                   Foreground="#C19C00"
                   FontSize="11"
                   AutomationProperties.Name="Partial purge" />
        <TextBlock Text="Purge failed"
                   IsVisible="{Binding IsPurgeFailed}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   FontSize="11"
                   AutomationProperties.Name="Purge failed" />
        <TextBlock Text="Purge completed"
                   IsVisible="{Binding IsPurgeSucceeded}"
                   Foreground="#107C10"
                   FontSize="11"
                   AutomationProperties.Name="Purge completed" />
        <Button Content="Cancel purge"
                Command="{Binding CancelPurgeCommand}"
                IsVisible="{Binding IsPurging}"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Cancel purge" />
      </StackPanel>
    </StackPanel>

    <!-- Tabs -->
    <TabControl Grid.Row="2" Margin="4,0,4,4">

      <!-- Description tab -->
      <TabItem Header="Description">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="16,12">

            <!-- Read-only stats — color-coded cards -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <!-- Active: blue -->
              <Border Background="#200078D4" CornerRadius="6" Padding="14,8" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="Active Messages" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Queue.ActiveMessageCount, FallbackValue='—'}"
                             FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <!-- Dead-letter: red -->
              <Border Background="#20D13438" CornerRadius="6" Padding="14,8" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="Dead-letter" FontSize="11" Foreground="#D13438" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Queue.DeadLetterCount, FallbackValue='—'}"
                             FontSize="22" FontWeight="SemiBold" Foreground="#D13438" />
                </StackPanel>
              </Border>
              <!-- Scheduled: purple -->
              <Border Background="#208764B8" CornerRadius="6" Padding="14,8" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="Scheduled" FontSize="11" Foreground="#8764B8" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Queue.ScheduledMessageCount, FallbackValue='—'}"
                             FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <!-- Status: neutral -->
              <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      CornerRadius="6" Padding="14,8" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="Status" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                  <TextBlock Text="{Binding Queue.Status, FallbackValue='—'}"
                             FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </WrapPanel>

            <Separator />

            <!-- Editable fields -->
            <Grid ColumnDefinitions="180,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Max delivery count" VerticalAlignment="Center" Margin="0,0,12,8" />
              <NumericUpDown Grid.Row="0" Grid.Column="1"
                             Value="{Binding MaxDeliveryCount}"
                             Minimum="1"
                             Maximum="2000"
                             Increment="1"
                             AutomationProperties.Name="Max delivery count"
                             AutomationProperties.HelpText="Maximum delivery attempts before Azure Service Bus dead-letters a message."
                             Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Lock Duration" VerticalAlignment="Center" Margin="0,0,12,8" />
              <ctrl:DurationEditor Grid.Row="1" Grid.Column="1"
                                   Value="{Binding LockDuration}"
                                   Constraint="{x:Static domain:DurationConstraint.LockDuration}"
                                   Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Message TTL" VerticalAlignment="Center" Margin="0,0,12,8" />
              <ctrl:DurationEditor Grid.Row="2" Grid.Column="1"
                                   Value="{Binding DefaultMessageTimeToLive}"
                                   Constraint="{x:Static domain:DurationConstraint.DefaultMessageTimeToLive}"
                                   Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-delete on Idle" VerticalAlignment="Center" Margin="0,0,12,8" />
              <ctrl:DurationEditor Grid.Row="3" Grid.Column="1"
                                   Value="{Binding AutoDeleteOnIdle}"
                                   Constraint="{x:Static domain:DurationConstraint.AutoDeleteOnIdle}"
                                   Margin="0,0,0,8" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Batched Operations" VerticalAlignment="Center" Margin="0,0,12,8" />
              <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding EnableBatchedOperations}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Dead-letter on Expiry" VerticalAlignment="Center" Margin="0,0,12,8" />
              <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding EnableDeadLetteringOnMessageExpiration}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="Forward To" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ForwardTo}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="7" Grid.Column="0" Text="Forward DL To" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ForwardDeadLetteredMessagesTo}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="8" Grid.Column="0" Text="User Metadata" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding UserMetadata}" Margin="0,0,0,8" />

              <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <Button Content="Update" Command="{Binding UpdateCommand}" />
                <TextBlock Text="Saving…" IsVisible="{Binding IsSaving}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{Binding SaveError}"
                           IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Messages tab -->
      <TabItem Header="Messages">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
            <TextBlock Text="Messages to peek" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding PeekCount}"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           AutomationProperties.Name="Messages to peek"
                           AutomationProperties.HelpText="Maximum number of messages to inspect without locking or removing them." />
            <ComboBox ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}"
                      PlaceholderText="Select source"
                      MinWidth="190"
                      AutomationProperties.Name="Message source" />
            <!-- Peek mode buttons (visible when NOT in receive mode) -->
            <Button Content="Peek"    Command="{Binding PeekCommand}"          IsVisible="{Binding !IsReceiveMode}" />
            <Button Content="Load more" Command="{Binding LoadMoreObservedCommand}" IsVisible="{Binding HasMoreObservedMessages}" />
            <Button Content="Purge"   Command="{Binding PurgeCommand}"         IsVisible="{Binding !IsReceiveMode}" />
            <Button Content="Receive" Command="{Binding StartReceiveCommand}"  IsVisible="{Binding !IsReceiveMode}" />
            <!-- Receive mode buttons (visible when IN receive mode) -->
            <Button Content="Receive Next" Command="{Binding ReceiveBatchCommand}" IsVisible="{Binding IsReceiveMode}" />
            <Button Content="Stop"         Command="{Binding StopReceiveCommand}"  IsVisible="{Binding IsReceiveMode}" />
            <TextBlock Text="● RECEIVE MODE" IsVisible="{Binding IsReceiveMode}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
          </StackPanel>
          <!-- Peek/browse message list -->
          <ListBox Grid.Row="1" x:Name="QueueObservedMessagesList"
                   Tag="{Binding}"
                   ItemsSource="{Binding ObservedMessages}"
                   SelectedItem="{Binding SelectedObservedMessage}"
                   IsVisible="{Binding !IsReceiveMode}"
                   Margin="8,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="4,2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding MessageId}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Source}" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Text="{Binding Body.Kind}" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                  </StackPanel>
                  <TextBlock Text="{Binding EnqueuedAt, StringFormat='Enqueued: {0:g}'}" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Receive-mode message list -->
          <ListBox Grid.Row="1" x:Name="QueueMessagesList"
                   Tag="{Binding}"
                   ItemsSource="{Binding Messages}"
                   SelectedItem="{Binding SelectedMessage}"
                   IsVisible="{Binding IsReceiveMode}"
                   Margin="8,0">
            <ListBox.ItemTemplate>
              <!-- No DataType here — runtime bindings needed for Tag-based context menu access -->
              <DataTemplate>
                <StackPanel Spacing="2" Margin="4,2"
                            Tag="{Binding $parent[ListBox].Tag}">
                  <StackPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Complete"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CompleteCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding LockToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <MenuItem Header="Abandon"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AbandonCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding LockToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <MenuItem Header="Dead-letter"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.DeadLetterCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding LockToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <TextBlock Text="{Binding MessageId}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EnqueuedAt, StringFormat='Enqueued: {0:g}'}" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" BorderThickness="0,1,0,0" MaxHeight="220"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding SelectedObservedMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Padding="8">
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedObservedMessage.MessageId, StringFormat='ID: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedObservedMessage.SequenceNumber, StringFormat='Seq: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SelectedObservedMessage.Source, StringFormat='Source: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding SelectedObservedMessage.Body.Kind, StringFormat='Body: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="4" Grid.Column="0"
                         Text="{Binding SelectedObservedMessage.Body.FullLengthBytes, StringFormat='Full size: {0} bytes (truncated)'}"
                         IsVisible="{Binding SelectedObservedMessage.Body.FullLengthBytes, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Margin="0,2" />
              <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="6" Orientation="Vertical" Spacing="6" Margin="8,0">
                <TextBlock Text="Sensitive content" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" MaxWidth="120" />
                <Button Content="Copy body" Command="{Binding CopyObservedBodyCommand}"
                        AutomationProperties.Name="Copy message body"
                        AutomationProperties.HelpText="Copies the displayed body after warning that content may be sensitive." />
                <Button Content="Export" Command="{Binding ExportObservedBodyCommand}"
                        AutomationProperties.Name="Export message body"
                        AutomationProperties.HelpText="Exports the displayed body after warning that content may be sensitive." />
              </StackPanel>
              <TextBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="6"
                       Text="{Binding SelectedObservedMessage.Body.DisplayText}"
                       IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Courier New,monospace"
                       TextWrapping="Wrap" />
            </Grid>
          </Border>
          <!-- Received message detail panel -->
          <Border Grid.Row="2" BorderThickness="0,1,0,0" MaxHeight="200"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Padding="8">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedMessage.MessageId, StringFormat='ID: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedMessage.SequenceNumber, StringFormat='Seq: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SelectedMessage.DeliveryCount, StringFormat='Delivery: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding SelectedMessage.ContentType, StringFormat='Type: {0}'}" Margin="0,2" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding SelectedMessage.DeadLetterReason, StringFormat='DL Reason: {0}'}"
                         IsVisible="{Binding SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,2" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="5"
                       Text="{Binding SelectedMessage.Body}"
                       IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Courier New,monospace"
                       TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Explicit source tab -->
      <TabItem Header="Source messages">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,8,8,4">
            <TextBlock Text="Messages to peek" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding PeekCount}"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           AutomationProperties.Name="Messages to peek"
                           AutomationProperties.HelpText="Maximum number of messages to inspect without locking or removing them." />
            <ComboBox ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}"
                      PlaceholderText="Select source"
                      MinWidth="190"
                      AutomationProperties.Name="Message source" />
            <Button Content="Peek" Command="{Binding PeekCommand}" />
            <Button Content="Load more" Command="{Binding LoadMoreObservedCommand}" IsVisible="{Binding HasMoreObservedMessages}" />
            <Button Content="Purge" Command="{Binding PurgeCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Margin="8,0,8,4"
                     Text="{Binding BrowseAvailability, StringFormat='Source status: {0}'}"
                     FontSize="11"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          <ListBox Grid.Row="2" ItemsSource="{Binding ObservedMessages}" SelectedItem="{Binding SelectedObservedMessage}" Margin="8,0,8,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="4,2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding MessageId}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Source}" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Text="{Binding Body.Kind}" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                  </StackPanel>
                  <TextBlock Text="{Binding DeadLetterReason}" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <!-- Send tab -->
      <TabItem Header="Send">
        <ContentControl Content="{Binding Send}" Margin="8" />
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
