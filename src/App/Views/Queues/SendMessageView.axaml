<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.ViewModels"
             xmlns:domain="using:ServiceBusExplorer"
             xmlns:ctrl="using:ServiceBusExplorer.App.Views.Controls"
             x:DataType="vm:SendMessageViewModel"
             x:Class="ServiceBusExplorer.App.Views.Queues.SendMessageView">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="Send Message" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DestinationDescription}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Actual publish destination"
                 AutomationProperties.HelpText="Identifies the queue or topic that receives the message." />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Body *" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding Body}"
                 AcceptsReturn="True"
                 MinHeight="120"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 TextWrapping="Wrap" />

        <TextBlock Text="Content Type" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding ContentType}" />

        <TextBlock Text="Message ID" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding MessageId}" />

        <TextBlock Text="Correlation ID" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding CorrelationId}" />

        <TextBlock Text="Session ID" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding SessionId}" />

        <TextBlock Text="To" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding To}" />

        <TextBlock Text="Application Properties (JSON)" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBox Text="{Binding PropertiesJson}"
                 AcceptsReturn="True"
                 MinHeight="60"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 TextWrapping="Wrap" />

        <Separator Margin="0,4" />

        <!-- Batch count + schedule -->
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Message count" VerticalAlignment="Center" Margin="0,0,8,0" />
          <NumericUpDown Value="{Binding SendCount}"
                         Minimum="1"
                         Maximum="1000"
                         Increment="1"
                         AutomationProperties.Name="Message count"
                         AutomationProperties.HelpText="Number of identical messages to send, from 1 to 1000."
                         Margin="0,0,12,0" />
          <CheckBox Content="Schedule in" IsChecked="{Binding UseScheduledTime}" VerticalAlignment="Center" />
          <ctrl:DurationEditor Value="{Binding ScheduleDelay}"
                               Constraint="{x:Static domain:DurationConstraint.ScheduledEnqueueDelay}"
                               IsEnabled="{Binding UseScheduledTime}"
                               Width="300"
                               Margin="8,0,0,0"
                               AutomationProperties.Name="Schedule delay"
                               AutomationProperties.HelpText="Delay from now before Azure Service Bus enqueues the message." />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="6">
      <TextBlock Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding Outcome}"
                 IsVisible="{Binding Outcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#107C10"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Send outcome" />
      <Button Content="Send" Command="{Binding SendCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
  </Grid>
</UserControl>
