<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.ViewModels"
             xmlns:domain="using:ServiceBusExplorer"
             xmlns:ctrl="using:ServiceBusExplorer.App.Views.Controls"
             x:DataType="vm:SendMessageViewModel"
             x:Class="ServiceBusExplorer.App.Views.Queues.SendMessageView">
  <UserControl.Styles>
    <Style Selector="TextBlock.field-help">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="Send Message" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DestinationDescription}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Actual publish destination"
                 AutomationProperties.HelpText="Identifies the queue or topic that receives the message." />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">
        <Border Padding="10"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="* Required. Conditional and optional fields are identified below."
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Classes="field-help"
                       Text="Not exposed in this internal composer: Subject/label, partition key, reply fields, absolute scheduled time, or message TTL." />
          </StackPanel>
        </Border>

        <StackPanel Spacing="3">
          <TextBlock Text="Body *" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Required. UTF-8 text sent as the message body; use JSON text when the content type is application/json." />
        <TextBox Text="{Binding Body}"
                 AcceptsReturn="True"
                 MinHeight="120"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Body"
                 AutomationProperties.HelpText="Required. UTF-8 text sent as the message body; use JSON text when the content type is application/json."
                 AutomationProperties.IsRequiredForForm="True" />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="Content type (optional)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Optional. MIME type describing the body, for example application/json; it does not transform the content." />
          <TextBox Text="{Binding ContentType}"
                   AutomationProperties.Name="Content type"
                   AutomationProperties.HelpText="Optional. MIME type describing the body, for example application/json; it does not transform the content."
                   AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="Message ID (optional)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Optional. Application-defined identifier; Azure duplicate detection uses it when enabled on the destination." />
          <TextBox Text="{Binding MessageId}"
                   AutomationProperties.Name="Message ID"
                   AutomationProperties.HelpText="Optional. Application-defined identifier; Azure duplicate detection uses it when enabled on the destination."
                   AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="Correlation ID (optional)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Optional. Associates related messages for application tracing; Azure Service Bus does not impose a format." />
          <TextBox Text="{Binding CorrelationId}"
                   AutomationProperties.Name="Correlation ID"
                   AutomationProperties.HelpText="Optional. Associates related messages for application tracing; Azure Service Bus does not impose a format."
                   AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="Session ID (conditionally required)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Conditionally required for session-enabled destinations. Routes the message to that ordered session." />
          <TextBox Text="{Binding SessionId}"
                   AutomationProperties.Name="Session ID"
                   AutomationProperties.HelpText="Conditionally required for session-enabled destinations. Routes the message to that ordered session."
                   AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="To (optional)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Optional logical destination metadata for consumers; it does not override the actual queue or topic shown above." />
          <TextBox Text="{Binding To}"
                   AutomationProperties.Name="To"
                   AutomationProperties.HelpText="Optional logical destination metadata for consumers; it does not override the actual queue or topic shown above."
                   AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <StackPanel Spacing="3">
        <TextBlock Text="Application properties (optional JSON)" FontWeight="SemiBold" />
        <TextBlock Classes="field-help"
                   Text="Optional. JSON object of custom key/value metadata included as Azure Service Bus application properties." />
        <TextBox Text="{Binding PropertiesJson}"
                 AcceptsReturn="True"
                 MinHeight="60"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Application properties"
                 AutomationProperties.HelpText="Optional. JSON object of custom key/value metadata included as Azure Service Bus application properties."
                 AutomationProperties.IsRequiredForForm="False" />
        </StackPanel>

        <Separator Margin="0,4" />

        <StackPanel Spacing="3">
          <TextBlock Text="Message count *" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Required. Number of identical messages to send, from 1 to 1000." />
          <NumericUpDown Value="{Binding SendCount}"
                         Minimum="1"
                         Maximum="1000"
                         Increment="1"
                         AutomationProperties.Name="Message count"
                         AutomationProperties.HelpText="Required. Number of identical messages to send, from 1 to 1000."
                         AutomationProperties.IsRequiredForForm="True" />
        </StackPanel>

        <StackPanel Spacing="3">
          <CheckBox Content="Schedule message (optional)"
                    IsChecked="{Binding UseScheduledTime}"
                    AutomationProperties.Name="Schedule message"
                    AutomationProperties.HelpText="Optional. Enable to enqueue the message after the relative delay instead of immediately."
                    AutomationProperties.IsRequiredForForm="False" />
          <TextBlock Classes="field-help"
                     Text="Optional. Enable to enqueue the message after the relative delay instead of immediately." />
        </StackPanel>

        <StackPanel Spacing="3">
          <TextBlock Text="Schedule delay * (when scheduling)" FontWeight="SemiBold" />
          <TextBlock Classes="field-help"
                     Text="Required when scheduling. Delay from now in D.HH:MM:SS[.fff] format; allowed range is 1 minute through 7 days." />
          <ctrl:DurationEditor Value="{Binding ScheduleDelay}"
                               Constraint="{x:Static domain:DurationConstraint.ScheduledEnqueueDelay}"
                               IsEnabled="{Binding UseScheduledTime}"
                               Width="300"
                               AutomationProperties.Name="Schedule delay"
                               AutomationProperties.HelpText="Required when scheduling. Delay from now in D.HH:MM:SS[.fff] format; Azure Service Bus enqueues after this interval."
                               AutomationProperties.IsRequiredForForm="{Binding UseScheduledTime}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="6">
      <TextBlock Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Send error"
                 AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="{Binding Outcome}"
                 IsVisible="{Binding Outcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#107C10"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Send outcome"
                 AutomationProperties.LiveSetting="Polite" />
      <Button Content="Send" Command="{Binding SendCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
  </Grid>
</UserControl>
