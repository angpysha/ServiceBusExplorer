<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="ServiceBusExplorer.App.Views.Main.MainView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBlock Grid.Row="0"
               Text="{Binding NamespaceName}"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ScopeBannerText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Crimson"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
      <Border Grid.Column="0"
              IsVisible="{Binding ShowQueuesPanel}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <ContentControl Content="{Binding Queues}" />
      </Border>

      <Border Grid.Column="2"
              IsVisible="{Binding ShowTopicsPanel}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <ContentControl Content="{Binding Topics}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
