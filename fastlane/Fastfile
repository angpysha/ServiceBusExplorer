# frozen_string_literal: true

# Optional local helper. CI notarization uses scripts/package-macos-internal.sh
# (xcrun notarytool + stapler) — not the flaky fastlane `notarize` action.

default_platform(:mac)

platform :mac do
  desc "Notarize and staple a signed macOS DMG via notarytool (ASC API key). Fail-closed on error."
  lane :macos_notarize_dmg do |options|
    dmg_path = options[:dmg_path] || ENV["DMG_PATH"]
    UI.user_error!("dmg_path is required") if dmg_path.to_s.empty?
    UI.user_error!("DMG not found: #{dmg_path}") unless File.exist?(dmg_path)

    key_path = ENV["APP_STORE_CONNECT_API_KEY_P8_PATH"].to_s
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
    issuer = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s
    if key_path.empty? || key_id.empty? || issuer.empty? || !File.exist?(key_path)
      UI.user_error!(
        "ASC API key missing: set APP_STORE_CONNECT_API_KEY_P8_PATH + " \
        "APP_STORE_CONNECT_API_KEY_ID + APP_STORE_CONNECT_ISSUER_ID " \
        "(run scripts/ci/import-apple-signing.sh). Prefer NOTARIZE=1 on package-macos-internal.sh for CI."
      )
    end

    # Direct Apple tooling — avoids fastlane notarize JSON parse crashes on Accepted.
    sh(
      "xcrun", "notarytool", "submit", dmg_path,
      "--key", key_path,
      "--key-id", key_id,
      "--issuer", issuer,
      "--wait",
      "--output-format", "json"
    )
    sh("xcrun", "stapler", "staple", dmg_path)
    sh("xcrun", "stapler", "validate", dmg_path)
    UI.success("Notarized and stapled via notarytool: #{dmg_path}")
  end
end
