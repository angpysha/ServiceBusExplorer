# Copy to .env (gitignored) before `docker compose up`.
# Emulator EULA: https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# SQL Edge EULA: https://go.microsoft.com/fwlink/?linkid=2139274

# Absolute path to Config.json (Docker volume mount requires a host absolute path)
# Example macOS/Linux: CONFIG_PATH=/Volumes/CoreProjects/OpenSourced/ServiceBusExplorer/tests/Integration/emulator/Config.json
CONFIG_PATH=/absolute/path/to/tests/Integration/emulator/Config.json

# Pass Y only after you accept both EULAs
ACCEPT_EULA=N

# Strong SA password per SQL Server policy (local emulator only; do not reuse production secrets)
MSSQL_SA_PASSWORD=Your_strong_Passw0rd!

# Seconds to wait for SQL Edge before emulator startup (optional)
SQL_WAIT_INTERVAL=15
